{
  "name": "browser-mcp-server",
  "version": "0.3.5",
  "description": "Chromium extension bridge MCP server - full browser automation (tabs, DOM, network, console)",
  "type": "module",
  "bin": {
    "browser-mcp": "bin/browser-mcp.js"
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test ./test/unit ./src",
    "test:integration": "bun test ./test/integration",
    "build:binary": "bun scripts/build-binaries.ts",
    "build:binaries": "bun scripts/build-binaries.ts --all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  }
}
