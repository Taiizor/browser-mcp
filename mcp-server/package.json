{
  "name": "@taiizor/browser-mcp",
  "version": "0.4.0",
  "description": "Chromium extension bridge MCP server - full browser automation (tabs, DOM, network, console)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "browser",
    "browser-automation",
    "chrome",
    "chromium",
    "edge",
    "extension",
    "bun"
  ],
  "homepage": "https://github.com/Taiizor/browser-mcp#readme",
  "bugs": {
    "url": "https://github.com/Taiizor/browser-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taiizor/browser-mcp.git",
    "directory": "mcp-server"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "browser-mcp": "bin/browser-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "bunfig.toml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test ./test/unit ./src",
    "test:integration": "bun test ./test/integration",
    "build:binary": "bun scripts/build-binaries.ts",
    "build:binaries": "bun scripts/build-binaries.ts --all",
    "docs:tools": "bun scripts/gen-tools-doc.ts",
    "docs:tools:check": "bun scripts/gen-tools-doc.ts --check",
    "prepack": "bun scripts/pack-assets.ts copy",
    "postpack": "bun scripts/pack-assets.ts clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  }
}
